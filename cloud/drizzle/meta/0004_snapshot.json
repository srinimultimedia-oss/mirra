          "name": "voting_end_check",
          "value": "(\"voting_sessions\".\"status\" = 'draft' AND \"voting_sessions\".\"ends_at\" IS NULL) OR (\"voting_sessions\".\"status\" IN ('active','ended') AND \"voting_sessions\".\"ends_at\" IS NOT NULL)"
        },
        "voting_items_check": {
          "name": "voting_items_check",
